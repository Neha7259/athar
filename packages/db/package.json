    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@athar/shared": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.6",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
