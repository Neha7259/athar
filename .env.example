# Copy to .env for local development
# DATABASE_URL: owner role — migrations only (db:generate/db:migrate/db:seed).
DATABASE_URL=postgres://athar:athar_dev@localhost:5432/athar
# APP_DATABASE_URL: restricted `athar_app` role the API runs as — has no
# UPDATE/DELETE on ledger_entries/audit_log. Created by the first migration.
APP_DATABASE_URL=postgres://athar_app:athar_app_dev@localhost:5432/athar
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=athar
S3_SECRET_KEY=athar_dev_secret
S3_BUCKET_EVIDENCE=athar-evidence
S3_BUCKET_EXPORTS=athar-exports
JWT_SECRET=change_me_in_prod
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# Anthropic API key — required for document extraction (Sprint 3+)
ANTHROPIC_API_KEY=
